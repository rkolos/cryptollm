{
  "name": "cryptollm",
  "version": "1.0.0",
  "description": "LLM-powered cryptocurrency trading bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "migrate:create": "npx node-pg-migrate create --migration-file-language ts --verbose",
    "migrate:run": "tsx ./scripts/migrate.ts",
    "migrate:up": "npm run migrate:run -- up",
    "migrate:down": "npm run migrate:run -- down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "node-pg-migrate": "^8.0.3",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/axios": "^0.14.4",
    "axios": "^1.13.1",
    "ccxt": "^4.5.14",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "technicalindicators": "^3.1.0",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  }
}
