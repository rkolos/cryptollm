# Application Mode
# Options: 'production', 'testnet', 'dry_run'
APP_MODE=dry_run

# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cryptollm
DB_PASSWORD=cryptollm
DB_NAME=cryptollm
# Alternative: use DATABASE_URL instead of individual DB_* variables
# DATABASE_URL=postgresql://cryptollm:cryptollm@localhost:5432/cryptollm

# Watchlist (comma-separated trading pairs)
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT

# LLM API Configuration
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here

# Telegram Bot Configuration (optional, for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Strategy Context
# Role and trading style configuration (JSON format)
STRATEGY_CONTEXT={"role":"Ты - профессиональный риск-менеджер и помощник трейдера","style":"Консервативный свинг-трейдер"}

# Risk Management Rules (JSON format)
RISK_RULES={"default_risk_per_trade_percent":1.5,"max_allowed_risk_per_trade_percent":3.0,"max_total_portfolio_risk_percent":10.0,"desired_risk_reward_ratio":3.0}

# PostgreSQL Docker Configuration
POSTGRES_USER=cryptollm
POSTGRES_PASSWORD=cryptollm
POSTGRES_DB=cryptollm
POSTGRES_PORT=5432
